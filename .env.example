# Copy to .env for local development. All values are optional; defaults shown.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to true only when running behind a trusted reverse proxy (e.g. Fly.io)
TRUST_PROXY=false

# --- Fetching untrusted URLs ---
# Total time budget to fetch a source (connect + redirects + download)
FETCH_TIMEOUT_MS=10000
# Max source file size in bytes (15 MB)
MAX_SOURCE_BYTES=15728640
# Max redirects followed; every hop is re-checked against the rules below
MAX_REDIRECTS=3
# Destination ports allowed for source URLs, or * for any
ALLOWED_PORTS=80,443
# Private/internal IPs to allow anyway, e.g. 127.0.0.1 to test against a local
# server. DEV/TEST ONLY: the app refuses to start with this set in production.
ALLOW_PRIVATE_ADDRESSES=

# --- Processing ---
# Max width/height a client may request
MAX_OUTPUT_DIMENSION=4000
# Max decoded pixels (width x height x frames) for input and output (50 MP)
MAX_INPUT_PIXELS=50000000
# Max time to process one image
PROCESSING_TIMEOUT_MS=15000
# Images processed in parallel (defaults to the number of CPU cores)
# MAX_CONCURRENT_JOBS=4

# --- Abuse protection ---
# Requests per client IP per window (0 disables). /health is never limited.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Caching (in memory, per instance) ---
# Processed images (100 MB, 1 hour). Set to 0 to disable.
RESULT_CACHE_MAX_BYTES=104857600
RESULT_CACHE_TTL_SECONDS=3600
# Downloaded originals, so changing params doesn't re-download (50 MB, 5 min)
SOURCE_CACHE_MAX_BYTES=52428800
SOURCE_CACHE_TTL_SECONDS=300
# Cache-Control max-age for browsers and CDNs (1 day)
HTTP_CACHE_MAX_AGE_SECONDS=86400
