# Copy to .env for local development. All values are optional; defaults shown.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to true only when running behind a trusted reverse proxy (e.g. Fly.io)
TRUST_PROXY=false
# Max time to wait for the source URL to respond
FETCH_TIMEOUT_MS=10000
