    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "lru-cache": "^11.5.3",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
