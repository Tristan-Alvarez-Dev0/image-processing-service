{
  "name": "@ips/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
